# mobile: Android / iOS / Flutter / NativeScript (dev add-on).
# needs: dev

tap "btwld/fvm", "https://github.com/btwld/homebrew-fvm.git"

brew "fvm"
brew "cocoapods"
brew "ios-deploy"
brew "ios-webkit-debug-proxy"
brew "openjdk"
brew "openjdk@11"
brew "ruby@3.3", link: true

cask "android-studio"
cask "android-ndk"
cask "android-platform-tools"
cask "temurin"

# desktop: GUI apps for a machine I actually sit at (work + dev GUIs).

tap "abue-ammar/tinycast", trusted: { casks: ["tinycast"] }
tap "anomalyco/tap", "https://github.com/anomalyco/homebrew-tap.git"
tap "blankeos/tap"
tap "microsoft/sysinternalstap"
tap "muxy-app/tap"

# terminals / editors
cask "ghostty"
cask "wezterm@nightly"
cask "zed"
cask "visual-studio-code"
cask "blankeos/tap/crabmd", trusted: true

# launcher / window / input
cask "tinycast"
cask "raycast"
cask "rectangle"
cask "mac-mouse-fix"
cask "middleclick"
cask "keycastr"
cask "annotate"
cask "microsoft/sysinternalstap/zoomit", trusted: true
cask "anomalyco/tap/hex", trusted: true
cask "fluidvoice"

# browsers
cask "vivaldi"
cask "google-chrome"
cask "firefox"

# dev GUIs
cask "beekeeper-studio"
cask "medis"
cask "mongodb-compass"
cask "yaak"
cask "cyberduck"
cask "herdr-app"
cask "opencode-desktop"
cask "t3-code@nightly"
cask "openusage"
cask "muxy-app/tap/muxy"
cask "excalidrawz"
cask "paper-design"
cask "rustdesk"
cask "tailscale-app"

# work
cask "slack"
cask "linear"
cask "notion"
cask "zoom"
cask "granola"
cask "grok-bot"

# system
cask "drivedx"
cask "adobe-acrobat-reader"

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "additionalDirectories": ["/Users/carlo/worktrees", "/tmp"],
    "allow": [
      "Read(**)",
      "Write(./**)",
      "Write(/Users/carlo/worktrees/**)",
      "Write(/tmp/**)",
      "Edit(/Users/carlo/worktrees/**)",
      "Edit(/tmp/**)",
      "Bash(**)",
      "Bash(git push**)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME**)",
      "Bash(git branch -d**)",
      "Bash(git branch -D**)",
      "Bash(git reset --hard**)",
      "Bash(git clean -f**)",
      "Bash(git rebase -i**)"
    ],
    "ask": [
      "Read(**/.env*)",
      "Read(**/.git/**)",
      "Read(**/*.env)"
    ]
  },
  "model": "opus",
  "hooks": {
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay ~/.config/opencode/plugin/nintendoerror.mp3 2>/dev/null -v 0.3 || true",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay ~/.config/opencode/plugin/nintendolaunch.mp3 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay ~/.config/opencode/plugin/pokeding.wav 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay ~/.config/opencode/plugin/nintendoerror.mp3 2>/dev/null -v 0.3 || true",
            "async": true
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "enabledPlugins": {
    "paper-desktop@paper": true,
    "slack@anthropic-plugin-directory": true
  },
  "extraKnownMarketplaces": {
    "paper": {
      "source": {
        "source": "github",
        "repo": "paper-design/agent-plugins"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-haiku-5-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "statusLine": {
    "type": "command",
    "command": "'/Applications/Codync.app/Contents/Resources/codync-host' statusline"
  }
}
